# Every variable apps/api/src/env.ts validates. Nothing in this repository loads a
# .env file — env.ts reads process.env — so this file is a menu, not a switch.
# `docker compose up` supplies five of these itself (the database URL, a dev
# session secret, the gateway origin, mock payouts, testnet) plus API_ORIGIN for
# the dashboard, and lets every other name fall through to env.ts's defaults —
# PORT among them, which is why the container listens on 3000 without being
# told, and why its log says the relayer has no key. To get the same result
# without Docker, source the file into
# the shell that starts the api and set the one value this file deliberately
# leaves blank:
#
#   set -a; . ./.env.example; set +a
#   export SESSION_SECRET=$(openssl rand -hex 32)
#
# That boots. An empty SESSION_SECRET does not: env.ts wants at least 32
# characters, so a copied file that never got a secret refuses to start rather
# than signing sessions with a constant. The same rule is why the optional
# values below are commented out instead of left blank — an unset variable is
# absent and takes its default, an empty one is a value and fails its own schema.
# Never commit a real value, and never create a .env from this file. The
# defaults — mock payouts on testnet — are the safe side (AGENTS.md "Money and
# secrets safety").
#
# A10 (human): record the testnet relayer / seller / payer ACCOUNT IDS in the
# comments below when they exist. Keys never appear in this file.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://till:till@localhost:5432/till

# --- NEAR -------------------------------------------------------------------
NEAR_NETWORK=near:testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# A placeholder, byte-identical to env.ts's own default so the file and the code
# disagree about nothing. A10 replaces it with the real testnet account.
RELAYER_ACCOUNT_ID=relayer.testnet
# Testnet funding only. A mainnet key here would be an incident, not a config.
# env.ts reads an empty key as absent, so leaving this blank boots unconfigured.
RELAYER_SECRET_KEY=

# C11 demo agent: the payer that calls the gateway. Both are A10's testnet
# accounts; with them empty, `pnpm demo`'s agent shows the 402 and stops at the
# paid leg rather than pretending. Never put a mainnet key here.
DEMO_PAYER_ACCOUNT_ID=
DEMO_PAYER_SECRET_KEY=

# --- Payouts ----------------------------------------------------------------
# mock = scripted outcomes, offline, the default for tests and the demo (PO-5).
# oneclick = real payouts and, per HACKATHON.md Q-007, mainnet movement: Intents
# has no testnet. ONECLICK_JWT is optional; without it the fee is higher (Q-006).
PAYOUT_PROVIDER=mock
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Commented out, not blank: `PAYOUT_PROVIDER=mock` never asks for it, and an
# empty ONECLICK_JWT is refused by its own schema (min 1) while an absent one is
# simply absent (Q-006: without a key the fee is 0.2%, not zero).
# ONECLICK_JWT=
# D3's rate shape. `/v0/status` answers ONE deposit address per call, so a pass
# that claims N swaps makes N calls, and the only spacing the provider publishes
# is "1 request every 5 seconds per partner ID" -- from the Explorer API, not the
# swap API, which is why spike S5 left the number unverified. The gap is what
# Till obeys; the cap is what keeps one pass inside one POLL_INTERVAL_SECONDS at
# that gap. Both are read by the 1Click client only; the mock ignores them.
ONECLICK_MIN_CALL_GAP_MS=5000
ONECLICK_STATUS_CALLS_PER_PASS=4

# --- Sessions and the public gateway ----------------------------------------
# At least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=
GATEWAY_PUBLIC_URL=http://localhost:3000

# --- Gateway guards (GW-5, GW-6, GW-10) -------------------------------------
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_BYTES=1048576
AUTHORIZATION_EXPIRY_MARGIN_MS=30000
# NEAR gas, not yoctoNEAR. Must be at least the 30000000000000 an ft_transfer
# delegate asks for, or verification rejects every payment (env.ts explains).
MAX_SPONSORED_GAS=30000000000000
# GW-10: process-wide, in memory, resets on restart. Requests are a fixed
# window over every GET /r/:slug; the gas budget reserves MAX_SPONSORED_GAS per
# settlement attempt and must be at least that, or boot refuses.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_MS=60000
SPONSORED_GAS_BUDGET=30000000000000000
# Set from spike S7 measurements. The value below is a placeholder, NOT a floor
# anyone has measured, and PO-2 must not ship against it.
MIN_PRICE_BASE_UNITS=10000
# UI-5: below this yoctoNEAR the dashboard header warns that sponsored gas may
# stop. Compared as an integer against the relayer account's own chain balance.
RELAYER_BALANCE_ALERT_BASE_UNITS=1000000000000000000000000
# Local dev escape hatch for an http upstream. Never set true in production.
ALLOW_INSECURE_UPSTREAM=false

# --- Jobs and reconciliation windows (D6, E2) -------------------------------
# C10's boot sweep has no window of its own: it uses Guard 3's in-flight window
# (UPSTREAM_TIMEOUT_MS + AUTHORIZATION_EXPIRY_MARGIN_MS), so a live request can
# never be mistaken for a dead process's row.
POLL_INTERVAL_SECONDS=20
# UI-5's poll staleness has no window of its own either: the header judges a
# silent provider after five intervals, because a second knob could drift from
# the loop it is meant to describe.
# D6's retry ceiling: after a provider call throws, each swap it was asking about
# waits POLL_INTERVAL_SECONDS * 2 ** attempts, capped at this. Must be >= the
# interval, or a failing swap would poll faster than a healthy one.
POLL_MAX_BACKOFF_SECONDS=900
RECONCILE_INTERVAL_SECONDS=60
# E9's PAYMENT_NOT_SWEPT window: how long a settled intents payment may wait for
# the swap that carries its hash before the reconciliation engine reports it.
SWEEP_WINDOW_SECONDS=300
STUCK_WINDOW_SECONDS=900
SHORTFALL_TOLERANCE_BPS=50

# --- Dashboard (apps/web) ---------------------------------------------------
# Not validated by apps/api/src/env.ts, which reads the names above and no others.
# `next.config.ts`'s /api/* rewrite and `lib/api-client.ts`'s server-side fetch both
# default to http://localhost:3000, which is PORT above; set this when the API runs
# somewhere else. Set it BEFORE `next build`: rewrites() is evaluated when
# .next/routes-manifest.json is written, so `next start` with a different value still
# proxies to the baked one (observed 2026-11-05 as a 500 on POST /api/endpoints while
# the server component's own fetch of the same origin succeeded).
API_ORIGIN=http://localhost:3000
