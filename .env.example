# Every variable apps/api/src/env.ts validates. Copy to .env (gitignored); never
# commit a real value. Defaults are mock payouts on testnet — the safe side
# (AGENTS.md hard rule 11, "Money and secrets safety").
#
# A10 (human): record the testnet relayer / seller / payer ACCOUNT IDS in the
# comments below when they exist. Keys never appear in this file.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://till:till@localhost:5432/till

# --- NEAR -------------------------------------------------------------------
NEAR_NETWORK=near:testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
RELAYER_ACCOUNT_ID=
# Testnet funding only. A mainnet key here would be a incident, not a config.
RELAYER_SECRET_KEY=

# C11 demo agent: the payer that calls the gateway. Both are A10's testnet
# accounts; with them empty, `pnpm demo`'s agent shows the 402 and stops at the
# paid leg rather than pretending. Never put a mainnet key here.
DEMO_PAYER_ACCOUNT_ID=
DEMO_PAYER_SECRET_KEY=

# --- Payouts ----------------------------------------------------------------
# mock = scripted outcomes, offline, the default for tests and the demo (PO-5).
# oneclick = real payouts and, per HACKATHON.md Q-007, mainnet movement: Intents
# has no testnet. ONECLICK_JWT is optional; without it the fee is higher (Q-006).
PAYOUT_PROVIDER=mock
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# --- Sessions and the public gateway ----------------------------------------
# At least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=
GATEWAY_PUBLIC_URL=http://localhost:3000

# --- Gateway guards (GW-5, GW-6, GW-10) -------------------------------------
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_MAX_BYTES=1048576
AUTHORIZATION_EXPIRY_MARGIN_MS=30000
# NEAR gas, not yoctoNEAR. Must be at least the 30000000000000 an ft_transfer
# delegate asks for, or verification rejects every payment (env.ts explains).
MAX_SPONSORED_GAS=30000000000000
# GW-10: process-wide, in memory, resets on restart. Requests are a fixed
# window over every GET /r/:slug; the gas budget reserves MAX_SPONSORED_GAS per
# settlement attempt and must be at least that, or boot refuses.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_MS=60000
SPONSORED_GAS_BUDGET=30000000000000000
# Set from spike S7 measurements. The value below is a placeholder, NOT a floor
# anyone has measured, and PO-2 must not ship against it.
MIN_PRICE_BASE_UNITS=10000
# Local dev escape hatch for an http upstream. Never set true in production.
ALLOW_INSECURE_UPSTREAM=false

# --- Jobs and reconciliation windows (D6, E2) -------------------------------
# C10's boot sweep has no window of its own: it uses Guard 3's in-flight window
# (UPSTREAM_TIMEOUT_MS + AUTHORIZATION_EXPIRY_MARGIN_MS), so a live request can
# never be mistaken for a dead process's row.
POLL_INTERVAL_SECONDS=20
# D6's retry ceiling: after a provider call throws, each swap it was asking about
# waits POLL_INTERVAL_SECONDS * 2 ** attempts, capped at this. Must be >= the
# interval, or a failing swap would poll faster than a healthy one.
POLL_MAX_BACKOFF_SECONDS=900
RECONCILE_INTERVAL_SECONDS=60
STUCK_WINDOW_SECONDS=900
SHORTFALL_TOLERANCE_BPS=50

# --- Dashboard (apps/web) ---------------------------------------------------
# Not validated by apps/api/src/env.ts, which reads the names above and no others.
# `next.config.ts`'s /api/* rewrite and `lib/api-client.ts`'s server-side fetch both
# default to http://localhost:3000, which is PORT above; set this when the API runs
# somewhere else. Set it BEFORE `next build`: rewrites() is evaluated when
# .next/routes-manifest.json is written, so `next start` with a different value still
# proxies to the baked one (observed 2026-11-05 as a 500 on POST /api/endpoints while
# the server component's own fetch of the same origin succeeded).
API_ORIGIN=http://localhost:3000
